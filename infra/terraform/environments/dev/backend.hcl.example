# cp backend.hcl.example backend.hcl で作成し、値を埋めてから
# terraform init -backend-config=backend.hcl を実行する（backend.hcl は .gitignore 済み）
bucket       = "<tfstate バケット名>"
key          = "pacs/dev/terraform.tfstate"
region       = "ap-northeast-1"
encrypt      = true
use_lockfile = true # S3 ネイティブロック（Terraform 1.10+）。DynamoDB テーブルは不要
